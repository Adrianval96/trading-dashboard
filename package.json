{
  "name": "trading-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "next typegen && tsc --noEmit",
    "generate:types": "openapi-typescript contract/openapi.yaml -o src/types.ts",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "happy-dom": "^21.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.10",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
